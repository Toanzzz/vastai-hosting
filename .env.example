# Copy to .env and set both API keys; no listing changes until DRY_RUN=false.
VAST_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_THINKING_BUDGET=1024
MACHINE_ID=51673
DRY_RUN=true
# Daily: the Gemini free tier allows 20 requests per model per day.
POLL_SECONDS=86400
MIN_PEERS=5
OFFER_LIMIT=200
MIN_PRICE=0.40
MAX_PRICE=1.00
MIN_CHANGE=0.01
# Optional: extra USD per GPU-hour a rented GPU costs you (power); 0 maximizes revenue.
GPU_RUNNING_COST=0

# Explicit full-listing settings. Check these against your current host listing.
DISK_PRICE=0.15
UPLOAD_PRICE=0.001953125
DOWNLOAD_PRICE=0.001953125
MIN_BID_PRICE=0.40
DISCOUNT_RATE=0.10
MIN_CHUNK=1
VOLUME_SIZE_GB=209
VOLUME_PRICE=0.15
# Rolling offer duration; review against your current host contract horizon.
DURATION_DAYS=7
